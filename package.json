{
  "name": "lingualink",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "ai:dev": "node --env-file=.env packages/ai/src/dev-server.ts",
    "mobile": "pnpm --filter @lingualink/mobile start",
    "android": "pnpm --filter @lingualink/mobile android"
  }
}
